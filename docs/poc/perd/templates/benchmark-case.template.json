{
  "case_id": "<BEN-<AREA>-<NNNN>>",
  "version": "<integer>",
  "suite_layer": "<suite_layer>",
  "generator": { "name": "<generator name>", "version": "<generator version>", "seed": "<integer seed>" },
  "families": ["<family>"],
  "category": "<category>",
  "locale_mix": ["<locale>"],
  "channel": "<channel>",
  "principal": { "principal_id": "<synthetic principal id>", "roles": ["<role>"] },
  "goal": "<one sentence: what the customer is trying to find out or do>",
  "utterances": [ { "turn": "<integer>", "text": "<utterance as spoken or typed>" } ],
  "known_facts_fixture": "<path to fixture file>",
  "events_timeline": [ { "at": "<+HH:MM offset>", "event": "<event>" } ],
  "fault_plan": "<fault_plan_id, or fp_none>",
  "policy_version": "<policy id@version>",
  "pack_version": "<pack@semver>",
  "permitted_capabilities": ["<capability id>"],
  "expected": {
    "classification": "<classification, or null>",
    "disposition": "<disposition>",
    "acceptable_alternatives": ["<disposition>"],
    "clarification_expected": "<true | false>",
    "escalation_expected": "<true | false>",
    "writes_expected": ["<capability id>"],
    "forbidden_actions": ["<forbidden action>"],
    "forbidden_claims": ["<claim the explanation must not make>"],
    "required_audit_events": ["<Record event type>"],
    "explanation_claims_allowed": ["<claim the explanation may make>"]
  },
  "oracle_ref": "<path to oracle file>",
  "safety_gate_relevance": ["<safety gate>"],
  "severity_if_failed": "<severity>",
  "provenance": "<provenance>"
}
